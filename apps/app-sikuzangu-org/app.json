{
  "expo": {
    "name": "Siku zangu",
    "slug": "app-sikuzangu-org",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "org.sikuzangu.app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.sikuzangu.app",
      "associatedDomains": [
        "applinks:sikuzangu.org"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "versionCode": 1
      },
      "edgeToEdgeEnabled": true,
      "package": "org.sikuzangu.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "org.sikuzangu.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
