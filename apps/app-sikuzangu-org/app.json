{
  "expo": {
    "name": "Siku zangu",
    "slug": "app-sikuzangu-org",
    "version": "1.1.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "org.sikuzangu.app",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.sikuzangu.app",
      "associatedDomains": [
        "applinks:sikuzangu.org"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "FirebaseCrashlyticsCollectionEnabled": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "C236Q758J2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 21,
      "edgeToEdgeEnabled": true,
      "package": "org.sikuzangu.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "org.sikuzangu.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "apps/app-sikuzangu-org/src/app"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E66386",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "extraMavenRepos": []
          },
          "ios": {
            "deploymentTarget": "16.1",
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      "./plugins/with-light-theme",
      "./plugins/with-universal-abi"
    ],
    "extra": {
      "router": {
        "root": "apps/app-sikuzangu-org/src/app"
      },
      "eas": {
        "projectId": "de89f1b8-4458-4af8-8e32-dca66d650b79"
      }
    }
  }
}
